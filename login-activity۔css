/*==================================================
LOGIN ACTIVITY DESIGN
==================================================*/

.activity-list {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin-bottom: 25px;
}

.activity-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 15px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

.activity-item i {
    font-size: 20px;
    color: #2e7d32;
    background: #e8f5e9;
    padding: 10px;
    border-radius: 50%;
}

.activity-item .info strong {
    display: block;
    color: #1a1a1a;
    font-size: 15px;
}

.activity-item .info span {
    color: #666;
    font-size: 13px;
}
