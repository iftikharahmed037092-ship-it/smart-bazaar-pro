/*==================================================
LOGIN ACTIVITY DESIGN (OPTIMIZED)
==================================================*/

.activity-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 25px;
}

.activity-item {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 14px 16px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    transition: all 0.2s ease;
}

.activity-item:hover {
    border-color: #cbd5e1;
    background: #f1f5f9;
}

.activity-item i {
    font-size: 18px;
    color: #2e7d32;
    background: #e8f5e9;
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    flex-shrink: 0;
}

.activity-item .info {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.activity-item .info strong {
    color: #1a1a1a;
    font-size: 14px;
    font-weight: 600;
}

.activity-item .info span {
    color: #64748b;
    font-size: 12px;
}
